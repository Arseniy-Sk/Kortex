<UserControl x:Class="Kortex.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Kortex.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="Spec" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Список найденных плат ============ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <Grid DockPanel.Dock="Right" Width="16" Height="16"
                          Visibility="{Binding Device.IsScanning, Converter={StaticResource BoolVis}}">
                        <Path Data="M8,1 A7,7 0 1 1 1,8" Stroke="{StaticResource B.Accent}" StrokeThickness="2"
                              StrokeStartLineCap="Round" Style="{StaticResource Spinner}">
                            <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                        </Path>
                    </Grid>
                    <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Device.Detected}" VerticalAlignment="Center"/>
                </DockPanel>

                <ListBox Grid.Row="1" Style="{StaticResource List}" Margin="0,12,0,0"
                         ItemContainerStyle="{StaticResource ListItem}"
                         ItemsSource="{Binding Device.Devices}"
                         SelectedItem="{Binding Device.Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="10"
                                        Margin="0,0,11,0" Background="{StaticResource B.Elevated}">
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ViaCapable}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource B.Cyan}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold"
                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border CornerRadius="5" Padding="6,1" Background="{StaticResource B.BrandSoft}">
                                            <TextBlock Style="{StaticResource T.Caption}" Text="{Binding Badge}"
                                                       Foreground="{StaticResource B.AccentSoft}"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource T.Caption}" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" Text="{Binding Vendor}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="6"
                            Visibility="{Binding Device.HasDevices, Converter={StaticResource BoolVis}, ConverterParameter=inv}">
                    <TextBlock Style="{StaticResource T.Dim}" TextWrapping="Wrap" TextAlignment="Center"
                               Text="{loc:Tr Device.NoneHint}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button Style="{StaticResource Btn}" Content="{loc:Tr Device.Rescan}"
                            Command="{Binding Device.ScanCommand}"/>
                    <Button Style="{StaticResource Btn.Ghost}" Margin="0,8,0,0"
                            Content="{loc:Tr Device.EnableDemo}" Command="{Binding Device.DemoCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Карточка устройства ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22,18">
                <Grid>
                    <Canvas ClipToBounds="True" IsHitTestVisible="False">
                        <Ellipse Width="300" Height="300" Canvas.Right="-60" Canvas.Top="-60"
                                 Fill="{StaticResource B.Glow}"/>
                    </Canvas>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Primary}" Content="{loc:Tr Device.Connect}"
                                    Command="{Binding Device.ConnectCommand}"/>
                            <Button Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0"
                                    Content="{loc:Tr Device.Disconnect}"
                                    Command="{Binding Device.DisconnectCommand}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource B.Brand}">
                                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource T.Caption}" Text="{Binding Device.HeaderTitle}"/>
                                <TextBlock Style="{StaticResource T.Base}" FontSize="22" FontWeight="Bold"
                                           Margin="0,2,0,0" Text="{Binding Device.HeaderName}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Характеристики -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="22,18"
                    Visibility="{Binding Device.HasSelection, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <WrapPanel>
                        <Border Style="{StaticResource Spec}" MinWidth="210">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Device.Model}"/>
                                <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold" Margin="0,3,0,0"
                                           Text="{Binding Device.ModelText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Spec}" MinWidth="180">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Device.Vendor}"/>
                                <TextBlock Style="{StaticResource T.Body}" Margin="0,3,0,0" Text="{Binding Device.VendorText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Spec}" MinWidth="200">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Device.Ids}"/>
                                <TextBlock Style="{StaticResource T.Mono}" Margin="0,3,0,0"
                                           Foreground="{StaticResource B.Cyan}" Text="{Binding Device.IdsText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Spec}" MinWidth="160">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Device.Form}"/>
                                <TextBlock Style="{StaticResource T.Body}" Margin="0,3,0,0" Text="{Binding Device.FormText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Spec}" MinWidth="210">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Device.Protocol}"/>
                                <TextBlock Style="{StaticResource T.Body}" Margin="0,3,0,0" Text="{Binding Device.ProtocolText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Spec}" MinWidth="150">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Device.Layers}"/>
                                <TextBlock Style="{StaticResource T.Body}" Margin="0,3,0,0" Text="{Binding Device.LayersText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Spec}" MinWidth="150">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Device.Matrix}"/>
                                <TextBlock Style="{StaticResource T.Mono}" Margin="0,3,0,0" Text="{Binding Device.MatrixText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Spec}" MinWidth="200">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Device.MacroSlots}"/>
                                <TextBlock Style="{StaticResource T.Mono}" Margin="0,3,0,0" Text="{Binding Device.MacroSlotsText}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <DockPanel Margin="0,6,0,0"
                               Visibility="{Binding Device.IsConnected, Converter={StaticResource BoolVis}}">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource T.Caption}"
                                   Text="{loc:Tr Device.Service}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource Btn.Ghost}" Padding="12,7" Margin="0,0,8,0"
                                    Content="{loc:Tr Device.EepromReset}"
                                    Command="{Binding Device.EepromResetCommand}"/>
                            <Button Style="{StaticResource Btn.Danger}" Padding="12,7"
                                    Content="{loc:Tr Device.Bootloader}"
                                    Command="{Binding Device.BootloaderCommand}"/>
                            <Border CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Background="{StaticResource B.BrandSoft}"
                                    Visibility="{Binding Device.VialDetected, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Device.Vial}"
                                           Foreground="{StaticResource B.Cyan}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <Border Background="#1AF5B24A" CornerRadius="10" Padding="13,10" Margin="0,10,0,0"
                            Visibility="{Binding Device.ShowSoftwareNote, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource B.Amber}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource T.Body}" Margin="10,0,0,0" TextWrapping="Wrap"
                                       Text="{loc:Tr Device.SoftwareOnly}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Подсветка и HID-интерфейсы -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="22,18"
                        Visibility="{Binding Device.IsConnected, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="12,6"
                                    Content="{loc:Tr Light.Save}" Command="{Binding Device.SaveLightingCommand}"
                                    Visibility="{Binding Device.HasLighting, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Style="{StaticResource T.H2}" Text="{loc:Tr Light.Title}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="1" Style="{StaticResource T.Dim}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Text="{loc:Tr Light.None}"
                                   Visibility="{Binding Device.HasLighting, Converter={StaticResource BoolVis}, ConverterParameter=inv}"/>

                        <StackPanel Grid.Row="1" Margin="0,14,0,0"
                                    Visibility="{Binding Device.HasLighting, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Light.Brightness}"/>
                            <Slider Style="{StaticResource Slider}" Minimum="0" Maximum="255" Margin="0,4,0,10"
                                    Value="{Binding Device.Brightness}"/>
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Light.Effect}"/>
                            <Slider Style="{StaticResource Slider}" Minimum="0" Maximum="40" Margin="0,4,0,10"
                                    Value="{Binding Device.Effect}"/>
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Light.Speed}"/>
                            <Slider Style="{StaticResource Slider}" Minimum="0" Maximum="255" Margin="0,4,0,10"
                                    Value="{Binding Device.Speed}"/>
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Light.Hue}"/>
                            <Slider Style="{StaticResource Slider}" Minimum="0" Maximum="255" Margin="0,4,0,10"
                                    Value="{Binding Device.Hue}"/>
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Light.Sat}"/>
                            <Slider Style="{StaticResource Slider}" Minimum="0" Maximum="255" Margin="0,4,0,6"
                                    Value="{Binding Device.Sat}"/>
                            <TextBlock Style="{StaticResource T.Dim}" FontSize="11.5"
                                       Foreground="{StaticResource B.Green}" Text="{Binding Device.LightingStatus}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,18"
                        Visibility="{Binding Device.HasSelection, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Device.Interfaces}"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Device.Selected.IsDemo, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource T.Dim}" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="420" Text="{loc:Tr Device.DemoHint}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                                      Visibility="{Binding Device.Selected.IsDemo, Converter={StaticResource BoolVis}, ConverterParameter=inv}">
                            <ItemsControl ItemsSource="{Binding Device.Selected.Model.Interfaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource B.SurfaceAlt}" CornerRadius="10"
                                                Padding="12,9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource T.Mono}" FontSize="11"
                                                           Foreground="{StaticResource B.Cyan}" Text="{Binding UsageText}"/>
                                                <Border Grid.Column="1" CornerRadius="5" Padding="7,1" Margin="0,0,10,0"
                                                        Background="#332F2A6B"
                                                        Visibility="{Binding IsRawHid, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Style="{StaticResource T.Caption}" Text="RAW HID · VIA"
                                                               Foreground="{StaticResource B.AccentSoft}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Style="{StaticResource T.Dim}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis" Text="{Binding Product}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
