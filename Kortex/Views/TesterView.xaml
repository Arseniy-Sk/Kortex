<UserControl x:Class="Kortex.Views.TesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kortex.Views"
             xmlns:loc="clr-namespace:Kortex.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Метрики ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Caption}"
                                   Text="{Binding Tester.RemainingText}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Tester.Tested}"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource T.Base}" FontSize="26" FontWeight="Bold"
                               Margin="0,4,0,8" Text="{Binding Tester.ProgressText}"/>
                    <Border Grid.Row="2" Height="6" CornerRadius="3" Background="#FF1C2130">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Tester.Progress, Converter={StaticResource RatioStar}}"/>
                                <ColumnDefinition Width="{Binding Tester.Progress, Converter={StaticResource RatioStar}, ConverterParameter=inv}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="3" Background="{StaticResource B.AccentGrad}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Tester.Presses}"/>
                    <TextBlock Style="{StaticResource T.Base}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                               Text="{Binding Tester.TotalPresses}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Tester.Nkro}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource T.Base}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource B.Cyan}" Text="{Binding Tester.MaxSimultaneous}"/>
                        <TextBlock Style="{StaticResource T.Dim}" Text="{loc:Tr Tester.Max}" VerticalAlignment="Bottom" Margin="7,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Tester.Chatter}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="ChatterValue" Style="{StaticResource T.Base}" FontSize="26" FontWeight="Bold"
                                   Text="{Binding Tester.ChatterCount}"/>
                        <TextBlock Style="{StaticResource T.Dim}" Text="{loc:Tr Tester.Events}" VerticalAlignment="Bottom" Margin="7,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Панель управления ================= -->
        <DockPanel Grid.Row="1" Margin="0,14,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="{loc:Tr Tester.Reset}"
                    Command="{Binding Tester.ResetCommand}"/>
            <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Padding="12,7" CornerRadius="10"
                    Margin="0,0,10,0" Background="{StaticResource B.SurfaceAlt}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource T.Dim}" Text="{loc:Tr Tester.BlockSystem}" VerticalAlignment="Center"/>
                    <ToggleButton Style="{StaticResource Switch}" Margin="10,0,0,0"
                                  IsChecked="{Binding BlockSystemKeys}"/>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Padding="12,7" CornerRadius="10"
                    Margin="0,0,10,0" Background="{StaticResource B.SurfaceAlt}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource T.Dim}" Text="{loc:Tr Tester.Heatmap}" VerticalAlignment="Center"/>
                    <ToggleButton Style="{StaticResource Switch}" Margin="10,0,0,0"
                                  IsChecked="{Binding Heatmap}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="7" Background="#332F2A6B" BorderBrush="{StaticResource B.Accent}"
                        BorderThickness="1" Padding="10,5">
                    <TextBlock Style="{StaticResource T.Base}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource B.AccentSoft}" Text="{Binding LayoutSummary}"/>
                </Border>
                <TextBlock Style="{StaticResource T.Dim}" Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="{Binding KeyCountText}"/>
            </StackPanel>
        </DockPanel>

        <!-- ================= Схема платы ================= -->
        <local:KeyboardBoard Grid.Row="2" Board="{Binding Tester.Board}"/>

        <!-- ================= Нижняя панель ================= -->
        <Grid Grid.Row="3" Margin="0,14,0,0" Height="196">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <!-- Последнее событие -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Tester.LastKey}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource T.Base}" FontSize="30" FontWeight="Bold"
                               Margin="0,2,0,10" TextTrimming="CharacterEllipsis"
                               Text="{Binding Tester.LastName}"/>
                    <UniformGrid Grid.Row="2" Columns="2" Rows="2" VerticalAlignment="Top">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Tester.Vk}"/>
                            <TextBlock Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Cyan}"
                                       Text="{Binding Tester.LastVk}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Tester.Scan}"/>
                            <TextBlock Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Cyan}"
                                       Text="{Binding Tester.LastScan}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Tester.Hold}"/>
                            <TextBlock Style="{StaticResource T.Mono}" Text="{Binding Tester.LastHold}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Tester.Flags}"/>
                            <TextBlock Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextDim}"
                                       Text="{Binding Tester.LastFlags}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Дребезг / непроверенные -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Tester.Diagnostics}"/>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding Tester.ChatterCount, Converter={StaticResource CountVis}}">
                            <ItemsControl ItemsSource="{Binding Tester.Chatter}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1AFF6B6B" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{StaticResource B.Red}" VerticalAlignment="Center"/>
                                                    <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold"
                                                               Margin="7,0,0,0" Text="{Binding Key}"/>
                                                    <TextBlock Style="{StaticResource T.Dim}" Margin="7,0,0,0"
                                                               Text="{Binding Count, StringFormat=×{0}}"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource T.Dim}" FontSize="11" Text="{Binding Info}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel VerticalAlignment="Top"
                                    Visibility="{Binding Tester.ChatterCount, Converter={StaticResource CountVis}, ConverterParameter=inv}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource B.Green}" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource T.Body}" Margin="7,0,0,0" Foreground="{StaticResource B.Green}"
                                           Text="{loc:Tr Tester.NoChatter}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,14,0,4" Text="{loc:Tr Tester.Untested}"/>
                            <TextBlock Style="{StaticResource T.Dim}" TextWrapping="Wrap" FontSize="11.5"
                                       Text="{Binding Tester.UntestedList}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Журнал -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Tester.Log}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Tester.Log}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource T.Mono}" FontSize="10.5"
                                                   Foreground="{StaticResource B.TextFaint}" Text="{Binding Time}"/>
                                        <TextBlock x:Name="Arrow" Grid.Column="1" Style="{StaticResource T.Mono}" FontSize="9"
                                                   Margin="8,0,0,0" Foreground="{StaticResource B.Green}" Text="{Binding Arrow}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource T.Body}" FontSize="11.5"
                                                   FontWeight="SemiBold" Margin="7,0,0,0" Text="{Binding Key}"/>
                                        <TextBlock Grid.Column="3" Style="{StaticResource T.Mono}" FontSize="10.5"
                                                   Margin="8,0,0,0" Foreground="{StaticResource B.TextFaint}"
                                                   Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDown}" Value="False">
                                            <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource B.TextFaint}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource B.Red}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
