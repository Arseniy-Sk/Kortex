<UserControl x:Class="Kortex.Views.KeymapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kortex.Views"
             xmlns:loc="clr-namespace:Kortex.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid>
        <!-- ============ Плата не подключена ============ -->
        <Border Style="{StaticResource Card}" Padding="40,34" VerticalAlignment="Center"
                HorizontalAlignment="Center" MaxWidth="640"
                Visibility="{Binding Keymap.HasDevice, Converter={StaticResource BoolVis}, ConverterParameter=inv}">
            <StackPanel>
                <Border Width="56" Height="56" CornerRadius="18" Background="{StaticResource B.BrandSoft}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                               Foreground="{StaticResource B.AccentSoft}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Style="{StaticResource T.H2}" Margin="0,18,0,0" HorizontalAlignment="Center"
                           Text="{loc:Tr Device.NotFound}"/>
                <TextBlock Style="{StaticResource T.Dim}" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           Text="{loc:Tr Keymap.NoDevice}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding GoCommand}" CommandParameter="5"
                            Content="{loc:Tr Nav.Device}"/>
                    <Button Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0"
                            Command="{Binding Device.DemoCommand}" Content="{loc:Tr Device.EnableDemo}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ Редактор раскладки ============ -->
        <Grid Visibility="{Binding Keymap.HasDevice, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Слои и состояние -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Tr Keymap.Import}"
                                Margin="0,0,8,0" Command="{Binding Keymap.ImportCommand}"/>
                        <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Tr Keymap.Export}"
                                Margin="0,0,8,0" Command="{Binding Keymap.ExportCommand}"/>
                        <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Tr Keymap.Rematch}"
                                ToolTip="{loc:Tr Keymap.RematchHint}" Margin="0,0,8,0"
                                Command="{Binding Keymap.RematchCommand}"/>
                        <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Tr Keymap.Reload}"
                                Command="{Binding Keymap.ReloadCommand}"/>
                        <Button Style="{StaticResource Btn.Danger}" Margin="8,0,0,0"
                                Content="{loc:Tr Keymap.ResetLayer}"
                                Command="{Binding Keymap.ResetLayerCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Keymap.Layers}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ItemsControl ItemsSource="{Binding Keymap.Layers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,7,0" Padding="15,7"
                                            Command="{Binding DataContext.Keymap.SelectLayerCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Title}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource B.Brand}"/>
                                                        <Setter Property="BorderBrush" Value="#FF8E7DFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border CornerRadius="8" Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="{StaticResource B.SurfaceAlt}" BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource T.Caption}" Text="MATRIX" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource T.Mono}" FontSize="11" Margin="8,0,0,0"
                                           Foreground="{StaticResource B.Cyan}" Text="{Binding Keymap.MatchText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Схема -->
            <local:KeyboardBoard x:Name="Board" Grid.Row="1" Margin="0,14,0,0"
                                 Board="{Binding Keymap.Board}" IsInteractive="True"/>

            <!-- Выбор кода -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16" Height="212">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Keymap.Selected}"/>
                        <TextBlock Style="{StaticResource T.Base}" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"
                                   Text="{Binding Keymap.SelectedTitle}"/>
                        <TextBlock Style="{StaticResource T.Mono}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{StaticResource B.Cyan}" Text="{Binding Keymap.SelectedMatrix}"/>
                        <TextBlock Style="{StaticResource T.Mono}" FontSize="11.5" Margin="0,8,0,0"
                                   Foreground="{StaticResource B.AccentSoft}" Text="{Binding Keymap.SelectedCodeName}"/>
                        <TextBlock Style="{StaticResource T.Dim}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="{Binding Keymap.Status}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0">
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource T.Caption}"
                                       Text="{loc:Tr Keymap.NewCode}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Grid HorizontalAlignment="Left" Width="240">
                                <TextBox Style="{StaticResource Input}" Padding="9,6"
                                         Text="{Binding Keymap.Search, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource T.Dim}" Margin="11,0,0,0" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Text="{loc:Tr Keymap.Search}"
                                           Visibility="{Binding Keymap.Search, Converter={StaticResource NotEmptyVis}, ConverterParameter=inv}"/>
                            </Grid>
                        </DockPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource B.SurfaceAlt}"
                            CornerRadius="11" BorderBrush="{StaticResource B.LineSoft}" BorderThickness="1"
                            Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Keymap.Codes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="3" Padding="10,6" MinWidth="52"
                                                Style="{StaticResource Btn.Ghost}"
                                                ToolTip="{Binding Name}"
                                                Content="{Binding Label}"
                                                Command="{Binding DataContext.Keymap.PickCodeCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
