<UserControl x:Class="Kortex.Views.RemapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kortex.Views"
             xmlns:loc="clr-namespace:Kortex.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Статус ================= -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                              IsChecked="{Binding Remap.Enabled}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Body}" VerticalAlignment="Center"
                           Margin="0,0,12,0" FontWeight="SemiBold" Text="{Binding Remap.RulesSummary}"/>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource B.AccentGrad}">
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource T.H2}" Text="{loc:Tr Remap.Engine}"/>
                        <TextBlock Style="{StaticResource T.Dim}" Text="{Binding Remap.StatusText}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Схема ================= -->
        <local:KeyboardBoard x:Name="Board" Grid.Row="1" Margin="0,14,0,0"
                             Board="{Binding Remap.Board}" IsInteractive="True"/>

        <!-- ================= Редактор ================= -->
        <Grid Grid.Row="2" Margin="0,14,0,0" Height="238">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Назначение -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="12,6"
                                Command="{Binding Remap.CaptureSourceCommand}" Content="{loc:Tr Remap.PickByPress}"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Remap.Source}"/>
                            <TextBlock Style="{StaticResource T.Base}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                                       Text="{Binding Remap.SelectedName}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Style="{StaticResource T.Dim}" Margin="0,10,0,0"
                               Foreground="{StaticResource B.AccentSoft}"
                               Text="{Binding Remap.CaptureHint}"
                               Visibility="{Binding Remap.IsCapturing, Converter={StaticResource BoolVis}}"/>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.35*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Remap.Action}" Margin="0,0,0,5"/>
                            <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Remap.Kinds}"
                                      SelectedItem="{Binding Remap.SelectedKind}" DisplayMemberPath="Name"/>
                        </StackPanel>

                        <Grid Grid.Column="1">
                            <!-- Цель: клавиша -->
                            <StackPanel Visibility="{Binding Remap.IsKeyTarget, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Remap.NewKey}" Margin="0,0,0,5"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="11,6"
                                            Margin="8,0,0,0" Command="{Binding Remap.CaptureTargetCommand}"
                                            ToolTip="{loc:Tr Remap.PickByPress}">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Button>
                                    <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Remap.TargetKeys}"
                                              SelectedItem="{Binding Remap.TargetKey}" DisplayMemberPath="Name"/>
                                </DockPanel>
                            </StackPanel>

                            <!-- Цель: макрос -->
                            <StackPanel Visibility="{Binding Remap.IsMacroTarget, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Remap.Macro}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="MacroCombo" Style="{StaticResource Combo}"
                                          ItemsSource="{Binding Remap.Macros}"
                                          SelectedItem="{Binding Remap.TargetMacro}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Цель: текст -->
                            <StackPanel Visibility="{Binding Remap.IsTextTarget, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Remap.Text}" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource Input}" Text="{Binding Remap.TargetText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="3" Style="{StaticResource T.Dim}" TextWrapping="Wrap" Margin="0,14,0,0"
                               VerticalAlignment="Bottom" FontSize="11.5"
                               Text="{loc:Tr Remap.Hint}"/>

                    <DockPanel Grid.Row="4" Margin="0,14,0,0">
                        <Button x:Name="ApplyButton" DockPanel.Dock="Left" Style="{StaticResource Btn.Primary}"
                                Content="{loc:Tr Remap.Assign}" Command="{Binding Remap.ApplyCommand}"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Ghost}"
                                Content="{loc:Tr Remap.ClearKey}" Margin="8,0,0,0"
                                Command="{Binding Remap.ClearCommand}"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Danger}"
                                Content="{loc:Tr Remap.ClearAll}" Margin="8,0,0,0"
                                Command="{Binding Remap.ClearAllCommand}"/>

                        <!-- Итог последнего действия: раньше кнопка «Назначить» молчала -->
                        <Border Margin="12,0,0,0" CornerRadius="9" Padding="11,7" VerticalAlignment="Center"
                                Background="#332F2A6B" BorderBrush="{StaticResource B.Accent}" BorderThickness="1"
                                Visibility="{Binding Remap.HasStatus, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource T.Body}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource B.AccentSoft}" Text="{Binding Remap.Status}"/>
                        </Border>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Список правил -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Remap.ActiveRules}"/>

                    <TextBlock Grid.Row="1" Style="{StaticResource T.Dim}" VerticalAlignment="Center"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Text="{loc:Tr Remap.EmptyHint}"
                               Visibility="{Binding Remap.Rules.Count, Converter={StaticResource CountVis}, ConverterParameter=inv}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Remap.Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource B.SurfaceAlt}" BorderBrush="{StaticResource B.LineSoft}"
                                            BorderThickness="1" CornerRadius="11" Padding="11,9" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Caption}" Width="28" Height="28"
                                                    Content="&#xE711;" ToolTip="Удалить правило"
                                                    Command="{Binding DataContext.Remap.RemoveRuleCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="9"
                                                    Background="#332F2A6B" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{StaticResource B.AccentSoft}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold" Text="{Binding From}"/>
                                                    <TextBlock Style="{StaticResource T.Dim}" Margin="7,0" Text="&#x2192;"/>
                                                    <TextBlock Style="{StaticResource T.Body}" Foreground="{StaticResource B.AccentSoft}"
                                                               FontWeight="SemiBold" Text="{Binding To}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource T.Caption}" Text="{Binding Badge}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
