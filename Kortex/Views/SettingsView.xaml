<UserControl x:Class="Kortex.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Kortex.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1120" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ Профиль ============ -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource T.H2}" Text="{loc:Tr Settings.Profile}"/>
                    <TextBlock Style="{StaticResource T.Dim}" Margin="0,3,0,14" TextWrapping="Wrap"
                               Text="{loc:Tr Settings.ProfileHint}"/>

                    <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Settings.ActiveProfile}" Margin="0,0,0,5"/>
                    <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding ActiveProfile}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Settings.NameField}" Margin="0,12,0,5"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding ProfileNameEditable, UpdateSourceTrigger=LostFocus}"/>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource Btn.Primary}" Content="{loc:Tr Settings.NewProfile}" Margin="0,0,8,8"
                                Command="{Binding NewProfileCommand}"/>
                        <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Tr Settings.Import}" Margin="0,0,8,8"
                                Command="{Binding ImportCommand}"/>
                        <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Tr Settings.Export}" Margin="0,0,8,8"
                                Command="{Binding ExportCommand}"/>
                        <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Tr Settings.Folder}" Margin="0,0,8,8"
                                Command="{Binding OpenFolderCommand}"/>
                        <Button Style="{StaticResource Btn.Danger}" Content="{loc:Tr Macro.Delete}" Margin="0,0,0,8"
                                Command="{Binding DeleteProfileCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ============ Сборка платы ============ -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource T.H2}" Text="{loc:Tr Settings.Build}"/>
                    <TextBlock Style="{StaticResource T.Dim}" Margin="0,3,0,14" TextWrapping="Wrap"
                               Text="{loc:Tr Settings.BuildHint}"/>

                    <WrapPanel>
                        <ToggleButton Style="{StaticResource Chip}" Content="ISO Enter" IsChecked="{Binding Iso}"/>
                        <ToggleButton Style="{StaticResource Chip}" Content="Split Backspace" IsChecked="{Binding SplitBackspace}"/>
                        <ToggleButton Style="{StaticResource Chip}" Content="Stepped Caps Lock" IsChecked="{Binding SteppedCaps}"/>
                        <ToggleButton Style="{StaticResource Chip}" Content="Split Right Shift" IsChecked="{Binding SplitRightShift}"/>
                        <ToggleButton Style="{StaticResource Chip}" Content="7u Spacebar" IsChecked="{Binding SevenUnitSpace}"/>
                    </WrapPanel>

                    <Border Background="{StaticResource B.SurfaceAlt}" CornerRadius="10" Padding="12,9" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource B.AccentSoft}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource T.Body}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding LayoutSummary}"/>
                            <TextBlock Style="{StaticResource T.Dim}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding KeyCountText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ Интерфейс ============ -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource T.H2}" Text="{loc:Tr Settings.Interface}"/>

                    <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr App.Language}" Margin="0,14,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource Chip}" Content="{loc:Tr Common.Russian}"
                                      IsChecked="{Binding IsRussian, Mode=OneWay}"
                                      Command="{Binding SetLanguageCommand}" CommandParameter="ru"/>
                        <ToggleButton Style="{StaticResource Chip}" Content="{loc:Tr Common.English}"
                                      IsChecked="{Binding IsEnglish, Mode=OneWay}"
                                      Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
                    </StackPanel>

                    <DockPanel Style="{StaticResource Row}" Margin="0,10,0,12">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding ShowWelcomeAtStart}"/>
                        <TextBlock Style="{StaticResource T.Body}" VerticalAlignment="Center"
                                   Text="{loc:Tr Settings.ShowWelcome}"/>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding Animations}"/>
                        <TextBlock Style="{StaticResource T.Body}" VerticalAlignment="Center"
                                   Text="{loc:Tr Tester.Pulse}"/>
                    </DockPanel>

                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding Heatmap}"/>
                        <TextBlock Style="{StaticResource T.Body}" VerticalAlignment="Center"
                                   Text="{loc:Tr Tester.Heatmap}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ============ Параметры теста ============ -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource T.H2}" Text="{loc:Tr Settings.TestParams}"/>
                    <TextBlock Style="{StaticResource T.Dim}" Margin="0,3,0,14" TextWrapping="Wrap"
                               Text="{loc:Tr Settings.ChatterHint}"/>

                    <DockPanel Margin="0,0,0,12">
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource Input}" Width="86"
                                 Text="{Binding ChatterThreshold, UpdateSourceTrigger=LostFocus}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource T.Body}" Text="{loc:Tr Settings.ChatterField}"/>
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Settings.ChatterRange}"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding BlockSystemKeys}"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource T.Body}" Text="{loc:Tr Settings.BlockKeys}"/>
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Settings.BlockKeysSub}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ============ Как это работает ============ -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource T.H2}" Text="{loc:Tr Settings.HowItWorks}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource T.Dim}" Margin="0,0,18,0" TextWrapping="Wrap"
                                   LineHeight="19" Text="{loc:Tr Settings.How1}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource T.Dim}" Margin="0,0,18,0" TextWrapping="Wrap"
                                   LineHeight="19" Text="{loc:Tr Settings.How2}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource T.Dim}" TextWrapping="Wrap"
                                   LineHeight="19" Text="{loc:Tr Settings.How3}"/>
                    </Grid>

                    <Border Background="{StaticResource B.SurfaceAlt}" CornerRadius="10" Padding="12,9" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.Caption}" Text="{loc:Tr Settings.File}"/>
                            <TextBlock Style="{StaticResource T.Mono}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap"
                                       Text="%AppData%\Kortex\profiles.json"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
