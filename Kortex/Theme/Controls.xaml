<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:Kortex.Localization">

    <!-- ===================== БАЗОВЫЙ ТЕКСТ ===================== -->
    <Style TargetType="TextBlock" x:Key="T.Base">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="T.H1" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="23"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="T.H2" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="T.Body" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="T.Dim" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="T.Caption" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="T.Mono" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ===================== КАРТОЧКА ===================== -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{StaticResource B.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- ===================== СКРОЛЛБАР ===================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="R" CornerRadius="4" Background="#FF313849" Margin="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="R" Property="Background" Value="#FF46506A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10"/>
                            <Setter Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== КНОПКИ ===================== -->
    <Style TargetType="Button" x:Key="Btn">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.Elevated}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="R" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="R" Property="Background" Value="{StaticResource B.Hover}"/>
                            <Setter TargetName="R" Property="BorderBrush" Value="#FF3A4257"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="R" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="R" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Btn.Primary" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource B.AccentGrad}"/>
        <Setter Property="BorderBrush" Value="#FF8E7DFF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style TargetType="Button" x:Key="Btn.Ghost" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
    </Style>

    <Style TargetType="Button" x:Key="Btn.Danger" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource B.RedDim}"/>
        <Setter Property="BorderBrush" Value="#55FF6B6B"/>
        <Setter Property="Foreground" Value="{StaticResource B.Red}"/>
    </Style>

    <!-- Иконочная кнопка заголовка окна -->
    <Style TargetType="Button" x:Key="Btn.Caption">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="R" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="R" Property="Background" Value="{StaticResource B.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Btn.Close" BasedOn="{StaticResource Btn.Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="R" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="R" Property="Background" Value="#FFE81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== НАВИГАЦИЯ ===================== -->
    <Style TargetType="RadioButton" x:Key="NavItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="R" Background="Transparent" CornerRadius="11" MinHeight="42"/>
                        <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource B.AccentGrad}" Opacity="0" Margin="-9,0,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="13,0" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="R" Property="Background" Value="#FF181D28"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="R" Property="Background" Value="#FF1C2130"/>
                            <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ПЕРЕКЛЮЧАТЕЛЬ ===================== -->
    <Style TargetType="ToggleButton" x:Key="Switch">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" CornerRadius="11" Background="#FF262C3B"
                            BorderBrush="{StaticResource B.Line}" BorderThickness="1">
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#FF8892A8"
                                 HorizontalAlignment="Left" Margin="2,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.AccentGrad}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#FF9E8DFF"/>
                            <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Чип -->
    <Style TargetType="ToggleButton" x:Key="Chip">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="R" Background="{StaticResource B.SurfaceAlt}" BorderBrush="{StaticResource B.Line}"
                            BorderThickness="1" CornerRadius="9" Padding="12,7">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="R" Property="Background" Value="{StaticResource B.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="R" Property="Background" Value="#332F2A6B"/>
                            <Setter TargetName="R" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ПОЛЕ ВВОДА ===================== -->
    <Style TargetType="TextBox" x:Key="Input">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="R" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="R" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== СПИСКИ ===================== -->
    <Style TargetType="ListBox" x:Key="List">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style TargetType="ListBoxItem" x:Key="ListItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="R" Background="{StaticResource B.SurfaceAlt}" BorderBrush="{StaticResource B.LineSoft}"
                            BorderThickness="1" CornerRadius="11" Padding="12,10">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="R" Property="Background" Value="{StaticResource B.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="R" Property="Background" Value="#332F2A6B"/>
                            <Setter TargetName="R" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== COMBOBOX ===================== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" x:Key="Combo">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="R" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9"/>
                        <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource TemplatedParent}}"
                                          Margin="10,8,28,8" VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                   Foreground="{StaticResource B.TextFaint}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="{StaticResource B.Elevated}" BorderBrush="{StaticResource B.Line}"
                                    BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MinHeight="34" MaxHeight="340">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                    <TextBlock x:Name="EmptyHint" Text="{loc:Tr Common.EmptyList}" Margin="10,7"
                                               FontFamily="{StaticResource F.Ui}" FontSize="12.5"
                                               Foreground="{StaticResource B.TextFaint}"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="R" Property="BorderBrush" Value="#FF3A4257"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="EmptyHint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="R" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="R" Property="Background" Value="{StaticResource B.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="R" Property="Background" Value="#332F2A6B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TOOLTIP ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource B.Elevated}" BorderBrush="{StaticResource B.Line}"
                            BorderThickness="1" CornerRadius="9" Padding="10,7">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ПЕРЕКЛЮЧАТЕЛЬ ЯЗЫКА ===================== -->
    <Style TargetType="ToggleButton" x:Key="LangChip">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="R" Background="Transparent" CornerRadius="7" Padding="10,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="R" Property="Background" Value="{StaticResource B.Brand}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ПОЛЗУНОК ===================== -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Width="16" Height="16" Fill="White"/>
                        <Ellipse Width="8" Height="8" Fill="#FF7C6BF7"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" x:Key="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="5" CornerRadius="3" Background="#FF1C2130"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" Width="16" Height="16"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
